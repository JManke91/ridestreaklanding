---
import { type Locale } from '../config';
import { getCopy } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getCopy(locale);

// Thin line icons, one per wedge statement. No cards, no borders — this band
// is a breath between the hero and the feature depth (§9.3).
const icons = [
  'M3 17l5-6 4 4 5-8 4 5', // trend line
  'M12 3v18M5 8l7-5 7 5M5 16l7 5 7-5', // analysis axis
  'M12 3a9 9 0 100 18 9 9 0 000-18zM12 8v4l3 2', // wear / time
];
---

<section class="band wedge">
  <div class="container">
    <p class="wedge-lead lead">{t.wedge.lead}</p>
    <ul class="wedge-grid">
      {
        t.wedge.items.map((item, i) => (
          <li class="reveal" style={`--reveal-delay:${i * 60}ms`}>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={icons[i]} />
            </svg>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .wedge {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .wedge-lead {
    max-width: 68ch;
    color: var(--rs-text);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.5;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .wedge-grid {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
    padding: 0;
    list-style: none;
  }

  .wedge-grid svg {
    width: 24px;
    height: 24px;
    color: var(--rs-teal);
    margin-bottom: 0.875rem;
  }

  .wedge-grid h3 {
    margin-bottom: 0.375rem;
  }

  .wedge-grid p {
    color: var(--rs-text-muted);
    font-size: 0.9375rem;
  }

  @media (min-width: 768px) {
    .wedge-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }
</style>
