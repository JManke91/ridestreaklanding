---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered CSS width of the phone in px. */
  width?: number;
  /** The hero image is the LCP element: eager, high priority, never lazy. */
  priority?: boolean;
  tilt?: boolean;
  glow?: boolean;
  class?: string;
}

const {
  src,
  alt,
  width = 380,
  priority = false,
  tilt = false,
  glow = false,
  class: className,
} = Astro.props;

// Screenshots are 1320×2868 (19.5:9). Serve at 1× and 2× of the rendered width.
const widths = [width, width * 2];

/*
  The fallback must be JPEG, not PNG. These are screenshots of satellite maps
  and gradients: the 2× PNG fallback for the flyover frame weighed 8.9 MB, and
  it is what any browser without AVIF/WebP support would download.
*/
---

<div
  class:list={['phone', { tilt, glow }, className]}
  style={`--phone-w:${width}px`}
>
  {glow && <div class="phone-glow" aria-hidden="true" />}
  <div class="phone-frame">
    <Picture
      src={src}
      alt={alt}
      widths={widths}
      sizes={`(max-width: 640px) 78vw, ${width}px`}
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      quality={72}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
    />
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: min(var(--phone-w), 78vw);
    flex-shrink: 0;
  }

  .phone-frame {
    position: relative;
    border-radius: 44px;
    padding: 8px;
    background: var(--rs-surface-2);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 40px 80px -20px rgba(0, 0, 0, 0.7);
  }

  .phone-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 36px;
  }

  .tilt {
    transform: perspective(1400px) rotateY(-12deg) rotateX(4deg);
    transform-style: preserve-3d;
  }

  .phone-glow {
    position: absolute;
    inset: -18% -28%;
    z-index: -1;
    background: radial-gradient(
      circle at 50% 42%,
      color-mix(in srgb, var(--rs-teal) 26%, transparent),
      transparent 68%
    );
    filter: blur(38px);
    pointer-events: none;
  }

  @media (max-width: 1023px) {
    .tilt {
      transform: none;
    }
  }
</style>
